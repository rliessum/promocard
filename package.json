{
  "name": "promo-card-generator",
  "version": "2.0.0",
  "description": "A modern, feature-rich tool to generate professional promotional cards for artists with advanced customization options.",
  "main": "index.html",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "serve": "python3 -m http.server 3000 --directory dist",
    "dev": "npm run watch:css",
    "build": "npm run build:css"
  },
  "keywords": [
    "promo",
    "card",
    "generator",
    "tailwind"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {},
  "overrides": {
    "postcss": ">=8.5.31",
    "brace-expansion": ">=1.1.21",
    "js-yaml": ">=4.3.2",
    "nanoid": ">=3.3.18",
    "source-map-js": ">=1.2.2",
    "colord": ">=2.9.4",
    "fast-uri": ">=3.1.9"
  }
}
